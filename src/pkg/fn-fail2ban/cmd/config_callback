#!/bin/bash
# ---------------------------------------------------------------------------
# 应用「设置」页面回调：面板已无登录页，这里只负责让改动立即生效。
# ---------------------------------------------------------------------------
set -u

HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=env.sh
. "${HERE}/env.sh"

# 重启面板，让最新的全局设置生效
"${HERE}/main" stop >/dev/null 2>&1
"${HERE}/main" start >/dev/null 2>&1

exit 0
